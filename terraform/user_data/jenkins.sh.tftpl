#!/bin/bash
# Jenkins box bootstrap: Java, Jenkins, Docker, AWS CLI, SSM plugin. 
set -euxo pipefail

dnf update -y
dnf install -y java-17-amazon-corretto git docker jq unzip
systemctl enable --now docker

wget -O /etc/yum.repos.d/jenkins.repo https://pkg.jenkins.io/redhat-stable/jenkins.repo
rpm --import https://pkg.jenkins.io/redhat-stable/jenkins.io-2023.key
dnf install -y jenkins

usermod -aG docker jenkins
systemctl enable --now jenkins

# AWS CLI v2 + Session Manager plugin (for the worker-rebake pipeline later)
curl -s "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install || true
dnf install -y https://s3.amazonaws.com/session-manager-downloads/plugin/latest/linux_64bit/session-manager-plugin.rpm || true

systemctl restart jenkins
