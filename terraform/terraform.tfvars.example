# Copy to terraform.tfvars and fill in. Only the first three are required.

# --- REQUIRED ---------------------------------------------------------------
# The two AMI IDs that `packer build` printed (see ../packer).
backend_ami_id = "ami-xxxxxxxxxxxxxxxxx"
worker_ami_id  = "ami-yyyyyyyyyyyyyyyyy"

# Where CloudWatch alarms email you (you confirm the subscription link once).
alert_email = "you@example.com"

# --- RECOMMENDED ------------------------------------------------------------
# Lock Jenkins (8080) + SSH (22) to your IP. Find it at https://checkip.amazonaws.com
# jenkins_ingress_cidr = "203.0.113.45/32"

# --- OPTIONAL (defaults shown) ----------------------------------------------
# aws_region             = "ap-south-1"
# single_nat_gateway     = false   # true = cheaper, less HA
# rds_multi_az           = true
# backend_instance_type  = "t3.micro"
# worker_instance_type   = "t3.medium"
# jenkins_instance_type  = "t3.medium"
# company                = "jio"
# sqs_visibility_timeout = 2000
